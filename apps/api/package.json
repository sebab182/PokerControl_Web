{
  "name": "@pokercontrol/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "start": "tsx src/server.ts",
    "e2e-server": "tsx --env-file-if-exists=../../.env src/e2e-server.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../../.env src/db/migrate.ts",
    "openapi": "tsx src/openapi.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.0.0",
    "@fastify/helmet": "^13.0.0",
    "@fastify/jwt": "^10.0.0",
    "@fastify/rate-limit": "^10.0.0",
    "@fastify/swagger": "^9.0.0",
    "@fastify/swagger-ui": "^5.0.0",
    "@fastify/websocket": "^11.3.6",
    "@pokercontrol/contracts": "workspace:*",
    "@pokercontrol/core": "workspace:*",
    "@sinclair/typebox": "^0.34.0",
    "drizzle-orm": "^0.44.0",
    "fastify": "^5.0.0",
    "google-auth-library": "^10.0.0",
    "pg": "^8.13.0",
    "tsx": "^4.19.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "drizzle-kit": "^0.31.0",
    "typescript": "^5.8.3",
    "vitest": "^3.0.0"
  }
}
